# Google Maps API Key (needs Directions API, Places API, Maps JavaScript API enabled)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenAI API Key (for generating descriptions)
OPENAI_API_KEY=your_openai_api_key_here

# Foursquare Places API Key (free tier: 10k calls/month - https://foursquare.com/developers/signup)
FOURSQUARE_API_KEY=your_foursquare_api_key_here
